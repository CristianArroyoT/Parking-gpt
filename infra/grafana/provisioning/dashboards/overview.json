  "panels": [
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "Total de eventos auditados en las últimas 24h (suma de success+failure).",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({job=\"solidapp\", event=\"audit\"} | json [24h]))",
          "refId": "A"
        }
      ],
      "title": "Eventos auditados (24h)",
      "type": "stat"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "Top acciones auditadas en las últimas 24h. Útil para detectar picos inusuales (ej. muchos 'login_failure').",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
      "id": 2,
      "options": {
        "legend": {"displayMode": "list", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "topk(10, sum by (action) (count_over_time({job=\"solidapp\", event=\"audit\"} | json [24h])))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "title": "Top 10 acciones (24h)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
