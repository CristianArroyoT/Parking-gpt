      "type": "stat"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "Volumen de creación de tickets por parking (top 5).",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 4,
      "options": {
        "legend": {"displayMode": "list", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "topk(5, sum by (parking_id) (count_over_time({job=\"solidapp\", event=\"audit\", action=\"ticket_created\"} | json [24h])))",
          "legendFormat": "parking {{parking_id}}",
          "refId": "A"
        }
      ],
      "title": "Top 5 parkings por tickets creados (24h)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "Distribución: tickets automáticos (vía OCR/heartbeat) vs manuales (operador).",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 5,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({job=\"solidapp\", event=\"audit\", action=\"manual_ticket_entry\"} | json [24h]))",
          "legendFormat": "manual entry",
          "refId": "A"
        },
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({job=\"solidapp\", event=\"audit\", action=\"manual_ticket_exit\"} | json [24h]))",
          "legendFormat": "manual exit",
          "refId": "B"
        },
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({job=\"solidapp\", event=\"audit\", action=\"ticket_created\"} | json [24h])) - sum(count_over_time({job=\"solidapp\", event=\"audit\", action=~\"manual_ticket_.*\"} | json [24h]))",
          "legendFormat": "automático",
          "refId": "C"
        }
      ],
      "title": "Tickets automáticos vs manuales (24h)",
      "type": "timeseries"
    }
