# Configuración de nginx para la app de producción (T-56).
#
# El README (§ PWA) documenta los TRES requisitos que tiene que cumplir
# el servidor estático que sirve `dist/`. Hasta ahora no había ninguno:
# el `Dockerfile` del frontend era el de DESARROLLO (Vite con HMR) y
# la QA del PWA servía el build con un `http.server` de usar y tirar.
# Es decir: los requisitos estaban escritos y nadie los cumplía.
#
# Los tres:
#   1. `Content-Type: application/manifest+json` para el manifiesto.
#   2. `Cache-Control: no-cache/no-store` para `/sw.js`: si el navegador
#      cachea el service worker, sigue ejecutando la versión vieja.
#   3. `index.html` sin cache (o con revalidación), para que un
#      despliegue nuevo se vea al abrir la app.
#
# La API va por proxy a `/api` (mismo criterio que el servidor de
# desarrollo): el bundle usa rutas relativas '/api/v1' a propósito, para
# que el navegador no tenga que saber dónde está el backend.
#
# La plantilla (`*.template`) la procesa el entrypoint oficial de nginx
# con `envsubst`, así que `${API_UPSTREAM}` se puede cambiar por entorno
# sin tocar la imagen.
#
# OJO: aquí **no** se puede usar `${API_UPSTREAM:-por_defecto}`: el
# `envsubst` de la imagen de nginx sólo sustituye las variables que
# existen tal cual (no entiende la sintaxis `:-`), y nginx reventaba al
# parsear el resto. El valor por defecto va en el `ENV` de la imagen.
#
# Y otra cosa que se aprendió al probarlo: **nginx resuelve el upstream
# AL ARRANCAR**, así que el contenedor NO LEVANTA si el nombre del
# backend no resuelve todavia. En el compose esto lo cubre
# `restart: unless-stopped` (el frontend reintenta hasta que el
# contenedor del backend existe); en un despliegue sin esa politica
# habria que poner el upstream en una variable con `resolver` para que
# se resolviera en cada peticion.

# El access log NO guarda la query string (T-93).
#
# POR QUE: el frontend mete el JWT en la query string de las miniaturas y
# del stream MJPEG (un ``<img>`` no puede mandar cabeceras), asi que con
# el log por defecto de nginx (``$request``, que es la linea completa) el
# token acababa **en texto claro** en el access log, y de ahi en Loki,
# que este repo scrapea. Medido el 2026-10-23 contra la imagen de
# produccion:
#
#   "GET /api/v1/incidents/attachments/1/thumbnail?token=SEGRETO... HTTP/1.1" 401
#
# Un access token son 15 minutos de vida y permisos de administrador: en
# un log es una credencial caducada, pero da acceso a lo que quede de ella
# y enseña la estructura de la API a quien lea el log.
#
# Con ``$uri`` (la ruta SIN la query string) se sigue viendo que se pidio,
# sin la credencial. El resto de campos se conservan.
#
# OJO: ``envsubst`` (el entrypoint de la imagen de nginx) sustituye
# SOLO las variables de entorno que existen, asi que estas ``$`` de nginx
# se quedan como estan.
log_format app_sin_query '$remote_addr - $remote_user [$time_local] '
                         '"$request_method $uri $server_protocol" $status '
                         '$body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    access_log /var/log/nginx/access.log app_sin_query;

    # Sonda de vida del propio nginx (la usa el HEALTHCHECK de la imagen).
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain always;
        return 200 "ok\n";
    }

    # ── 1. El manifiesto ─────────────────────────────────────────────────
    # Chrome exige ``application/manifest+json`` para ofrecer "Instalar
    # app".
    #
    # OJO: un bloque ``types`` **sustituye** el mapa MIME que hereda el
    # servidor (no lo amplía). Si se declarase aquí, el JS y el HTML se
    # servirían como ``application/octet-stream`` y el navegador **no
    # ejecutaría el bundle** (y el HTML no se renderizaría). Por eso el
    # tipo del manifiesto se declara **sólo** en su ubicación, y el resto
    # de ubicaciones conserva el mapa MIME heredado.
    location = /manifest.webmanifest {
        types {
            application/manifest+json webmanifest;
        }
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    # ── 2. El service worker, NUNCA cacheado ────────────────────────────
    # Si el navegador cachea el SW, sigue ejecutando la versión vieja
    # aunque se haya desplegado otra: el usuario se queda con un bundle
    # obsoleto (y el SW antiguo puede cachear assets viejos).
    location = /sw.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        expires -1;
    }

    # ── 3. El shell de la SPA, sin cache ────────────────────────────────
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
    }
    location = / {
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # ── La API: siempre a la red, nunca al caché del SW ────────────────
    #
    # OJO (T-67): el ``^~`` no es decorativo. En nginx, las locations de
    # tipo REGEX (``location ~* \.(png|jpg|...)$``) se comprueban ANTES
    # que las de prefijo: sin el ``^~``, una peticion a
    # ``/api/v1/algo.png`` la servia nginx desde el disco en vez de ir a
    # la API. Hoy no rompe nada (los adjuntos van por
    # ``/attachments/{id}``, sin extension), pero es una trampa para el
    # dia que un endpoint devuelva una imagen.
    location ^~ /api/ {
        # OJO (T-60): SIN esta directiva nginx acepta **1 MB** por
        # peticion (su default), y el backend acepta 3 ficheros de 10 MB
        # (``incident_attachment_max_bytes`` x
        # ``incident_attachment_max_files``). Medido: una foto de 2 MB
        # devolvia un 413 de nginx (HTML) y el backend no llegaba a verla.
        # En desarrollo (Vite) no habia limite, asi que el fallo solo
        # aparecia en produccion.
        #
        # El valor lo vigila ``tools/verificar_nginx_body_size.py``: si el
        # backend sube su tope, esta puerta avisa.
        client_max_body_size 32m;
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # OJO (T-62): esto SOBREESCRIBE el XFF del cliente con la IP que
        # nginx ve de verdad. Con ``$proxy_add_x_forwarded_for`` (que
        # concatena) el cliente podia inyectar su propia IP delante de la
        # real, y el backend leia justo esa: el rate-limit de login se
        # esquivaba mandando un XFF distinto en cada intento.
        #
        # OJO: si delante de nginx hay un CDN (Cloudflare), hay que activar
        # el modulo ``realip`` de nginx (``set_real_ip_from`` + ``real_ip``
        # + ``real_ip_recursive on``) para que ``$remote_addr`` sea la IP
        # real del visitante y no la del CDN.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Los tickets de SSE (eventos del parking) no deben bufferizarse.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # ── Los assets con hash: se cachean para siempre ───────────────────
    # `index-<hash>.js` cambia de nombre cuando cambia el contenido, así
    # que cachearlos para siempre es seguro.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # ── El resto de estáticos ─────────────────────────────────────────
    location ~* \.(png|jpg|jpeg|gif|svg|ico|webp|woff2?|ttf|eot)$ {
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    # ── La SPA: cualquier ruta desconocida devuelve el shell ───────────
    # (es una SPA con enrutado del lado del cliente: /mis-tickets,
    # /admin/users, … no son ficheros).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Ficheros ocultos: no se sirven.
    location ~ /\. {
        deny all;
    }
}
