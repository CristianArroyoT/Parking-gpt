# Objetivo del proxy interno de Vite (vite.config.ts). NO se inyecta al
# bundle del frontend porque su nombre no empieza por VITE_API_*.
#   - Vacío o sin definir → http://localhost:8000 (útil en local sin Docker).
#   - http://backend:8000  → dentro del contenedor frontend de la pila
#     docker-compose (ya viene configurado ahí).
VITE_PROXY_TARGET=http://localhost:8000