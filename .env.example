# =============================
# solidAPP · entorno de desarrollo
# =============================
# Copia este fichero a .env y rellena los valores reales.

# --- Postgres / PostGIS ---
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking
POSTGRES_DB=parking
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://parking:parking@db:5432/parking
ASYNC_DATABASE_URL=postgresql+asyncpg://parking:parking@db:5432/parking

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Backend / Auth ---
JWT_SECRET=change-me-in-production-32-bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
API_HOST=0.0.0.0
API_PORT=8000
API_TIMEOUT_MS=30000

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- URL publica del frontend (T-61) ---
# La que va en los correos (el de recuperar contrasena). En
# staging/produccion tiene que ser una URL real por HTTPS: con el valor
# por defecto la API NO ARRANCA.
FRONTEND_BASE_URL=http://localhost:5173

# --- Proxies de confianza (T-62) ---
# CIDRs de los proxies que pueden poner el X-Forwarded-For. Si el proxy
# de produccion esta fuera de los rangos de por defecto, hay que
# anadirlo aqui: si no, el backend ve la IP del proxy y el rate-limit de
# login se comparte para toda la sucursal.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8

# --- OCR (Fase 2) ---
OCR_ENGINE=paddleocr
OCR_LANG=es
OCR_CONFIDENCE_THRESHOLD=0.85
OCR_FRAMES_BEFORE_FAIL=5
OCR_FAILED_DIR=/tmp/ocr-failed

# --- SMTP (Fase 2) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=solidAPP <no-reply@solidapp.es>

# --- Cámaras IP (RTSP) ---
# Una variable por cámara; en el MVP se documentan 10.
RTSP_URL_CAM_01=rtsp://usuario:password@camara-01.local:554/stream1
RTSP_URL_CAM_02=rtsp://usuario:password@camara-02.local:554/stream1
RTSP_URL_CAM_03=rtsp://usuario:password@camara-03.local:554/stream1
RTSP_URL_CAM_04=rtsp://usuario:password@camara-04.local:554/stream1
RTSP_URL_CAM_05=rtsp://usuario:password@camara-05.local:554/stream1
RTSP_URL_CAM_06=rtsp://usuario:password@camara-06.local:554/stream1
RTSP_URL_CAM_07=rtsp://usuario:password@camara-07.local:554/stream1
RTSP_URL_CAM_08=rtsp://usuario:password@camara-08.local:554/stream1
RTSP_URL_CAM_09=rtsp://usuario:password@camara-09.local:554/stream1
RTSP_URL_CAM_10=rtsp://usuario:password@camara-10.local:554/stream1

# --- Frontend (Vite) ---
VITE_API_BASE=http://localhost:8000

# --- Preview en vivo (MJPEG) ---
# Fps objetivo del preview de la vista en vivo (decisión D1 del plan de
# pendientes, 2026-10-21): 5 fps por defecto. Medido: 4,97 fps con el
# límite frente a 25,01 fps sin él → un 85,5 % menos de ancho de banda,
# con la latencia útil por debajo de 400 ms.
# Poner 0 (o un valor no positivo) = SIN limitador: el preview va al
# ritmo de la cámara (modo "tiempo real" del sprint Latencia-Mínima).
LIVE_PREVIEW_FPS=5

# --- Reconocimiento facial (T-23, 2026-10-21) ---
# **DESACTIVADO y fuera del MVP**: la tabla y el endpoint existen
# (preparación), pero el reconocimiento facial NO se usa para autenticar
# a nadie. Ponerlo en true habilita el alta/baja de plantillas; la
# autenticación sigue siendo usuario+contraseña.
FACE_TEMPLATES_ENABLED=false

# --- Observabilidad + Auditoría (Sprint Fase 3A, 2026-07-01) ---
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (default INFO).
# LOG_FORMAT: plain (legible en docker logs) | json (parseable por Promtail).
LOG_LEVEL=INFO
LOG_FORMAT=plain
# LOKI_URL sólo lo usa Promtail como destino del push (backend lo ignora).
LOKI_URL=http://loki:3100
# Retención de audit_logs (días). La rotación automática entra en sprint 3D.
AUDIT_LOG_RETENTION_DAYS=365
# Contraseña admin inicial de Grafana (cambiar en producción).
GRAFANA_ADMIN_PASSWORD=admin

# --- Fotos de los incidentes (T-21, 2026-10-21) ---
# El binario de las fotos NO va a la base de datos: vive en este volumen
# local con el nombre derivado del hash del contenido. En la BD sólo
# queda la metadata (nombre, hash, mime, tamano y ruta).
# Retencion: 90 dias (LOPDGDD). Purga:
#   docker compose exec backend python -m app.scripts.purge_incident_attachments
INCIDENT_ATTACHMENTS_DIR=/var/lib/solidapp/incident-attachments
# Tamano maximo por foto (10 MB). Una foto de movil pesa 3-5 MB.
INCIDENT_ATTACHMENT_MAX_BYTES=10485760
# Maximo de fotos por incidente (el wireframe pide "hasta 3 fotos").
INCIDENT_ATTACHMENT_MAX_FILES=3
# Tipos admitidos. Se verifican por los BYTES del fichero, no por la
# extension. SVG NO se acepta (es XML ejecutable).
INCIDENT_ATTACHMENT_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
# Dias que se conservan las fotos antes de la purga.
INCIDENT_ATTACHMENT_RETENTION_DAYS=90